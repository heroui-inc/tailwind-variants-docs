{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tailwind-variants.org"
        }
      ],
      "destination": "https://www.tailwind-variants.org/:path*",
      "permanent": true
    }
  ]
}
