    "fumadocs-mdx": "15.5.3",
    "fumadocs-ui": "16.18.4",
    "mcp-handler": "2.3.1",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.6.0",
